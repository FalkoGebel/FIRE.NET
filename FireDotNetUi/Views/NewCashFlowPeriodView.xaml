<Window x:Class="FireDotNetUi.Views.NewCashFlowPeriodView"
        x:Name="NewCashFlowPeriodViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FireDotNetUi.Views"
        xmlns:r="clr-namespace:FireDotNetUi.Properties"
        xmlns:vm="clr-namespace:FireDotNetUi.ViewModels"
        xmlns:uc="clr-namespace:FireDotNetUi.UserControls"
        mc:Ignorable="d"
        Title="{x:Static r:Resources.NewCashFlowPeriodView_Title}"        
        Style="{DynamicResource ResourceKey=WindowDefaultStyle}"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Window.DataContext>
        <vm:NewCashFlowPeriodViewModel />
    </Window.DataContext>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="{x:Static r:Resources.NewCashFlowPeriodView_Label_StartingMonth}" VerticalContentAlignment="Center" Margin="10,5,5,5" Width="165"/>
            <uc:MonthPicker SelectedDate="{Binding StartingMonth, Mode=TwoWay}"
                            Margin="0,5,10,5"
                            VerticalContentAlignment="Center"
                            TextBoxWidth="225" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="{x:Static r:Resources.NewCashFlowPeriodView_Label_EndingMonth}" VerticalContentAlignment="Center" Margin="10,5,5,5" Width="165"/>
            <uc:MonthPicker SelectedDate="{Binding EndingMonth, Mode=TwoWay}"
                            Margin="0,5,10,5"
                            VerticalContentAlignment="Center"
                            TextBoxWidth="225" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="{x:Static r:Resources.NewCashFlowPeriodView_Label_DurationInMonths}" VerticalContentAlignment="Center" Margin="10,5,5,5" Width="165"/>
            <TextBox Text="{Binding DurationInMonthsInput, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                     Width="250"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Right"
                     Margin="0,5,10,5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="{x:Static r:Resources.NewCashFlowPeriodView_Label_MonthlyAmount}" VerticalContentAlignment="Center" Margin="10,5,5,5" Width="165"/>
            <TextBox Text="{Binding MonthlyAmountInput, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                     Width="250"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Right"
                     Margin="0,5,10,5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="{x:Static r:Resources.NewCashFlowPeriodView_Label_InflationOption}" VerticalContentAlignment="Center" Margin="10,5,5,5" Width="165"/>
            <ComboBox ItemsSource="{Binding InflationOptions}"
                      SelectedItem="{Binding SelectedInflationOption, Mode=TwoWay}"
                      SelectedIndex="0"
                      Margin="0,5,10,5"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Right"
                      Width="250">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
            <Button Content="{x:Static r:Resources.NewCashFlowPeriodView_Button_Content_Cancel}" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=NewCashFlowPeriodViewWindow}" Margin="10,5,5,5" Padding="5" IsCancel="True" IsDefault="True" />
            <Button Content="{x:Static r:Resources.NewCashFlowPeriodView_Button_Content_Submit}" Command="{Binding SubmitCommand}" CommandParameter="{Binding ElementName=NewCashFlowPeriodViewWindow}" Margin="5,5,0,5" Padding="5"/>
        </StackPanel>
    </StackPanel>
</Window>
