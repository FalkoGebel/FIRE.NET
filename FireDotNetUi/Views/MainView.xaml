<Window x:Class="FireDotNetUi.MainView"
        x:Name="MainViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FireDotNetUi"
        xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
        xmlns:vm="clr-namespace:FireDotNetUi.ViewModels"
        xmlns:r="clr-namespace:FireDotNetUi.Properties"
        xmlns:uc="clr-namespace:FireDotNetUi.UserControls"
        mc:Ignorable="d"
        Title="{x:Static r:Resources.MainView_Title}" WindowState="Maximized" Style="{DynamicResource ResourceKey=WindowDefaultStyle}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Label Content="{x:Static r:Resources.MainView_Label_StartAmount}" VerticalContentAlignment="Center" Width="225"/>
                    <TextBox Text="{Binding StartingAmountInput, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Label Content="{x:Static r:Resources.MainView_Label_AnnualInflationRate}" VerticalContentAlignment="Center" Width="225"/>
                    <TextBox Text="{Binding AnnualInflationRate, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Label Content="{x:Static r:Resources.MainView_Label_AnnualReturn}" VerticalContentAlignment="Center" Width="225"/>
                    <TextBox Text="{Binding AnnualReturn, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Label Content="{x:Static r:Resources.MainView_Label_AnnualVolatility}" VerticalContentAlignment="Center" Width="225"/>
                    <TextBox Text="{Binding AnnualVolatility, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Label Content="{x:Static r:Resources.MainView_Label_NumberOfMultipleRuns}" VerticalContentAlignment="Center" Width="225"/>
                    <ComboBox ItemsSource="{Binding NumberOfMultipleRuns}" SelectedItem="{Binding SelectedNumberOfMultipleRuns, Mode=TwoWay}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static r:Resources.MainView_Button_Content_Calculate}" Command="{Binding CalculateCommand}" VerticalContentAlignment="Center" Padding="5"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <uc:MonthPicker SelectedDate="{Binding StartingMonth, Mode=TwoWay}" Margin="10,5,0,0" VerticalContentAlignment="Center" TextBoxWidth="150" IsEnabled="False"/>
                    <uc:MonthPicker SelectedDate="{Binding EndingMonth, Mode=TwoWay}" Margin="10,5,0,0" VerticalContentAlignment="Center" TextBoxWidth="150" IsEnabled="False"/>
                    <Label Content="{x:Static r:Resources.MainView_Label_DurationInMonths}" VerticalContentAlignment="Center" Margin="10,5,0,0"/>
                    <TextBox Text="{Binding DurationInMonthsInput, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" MinWidth="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="0,5,0,0" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ListView ItemsSource="{Binding CashFlowPeriods}"
                      Height="180" SelectionMode="Single"
                      SelectedItem="{Binding SelectedCashFlowPeriod, Mode=TwoWay}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn
                            DisplayMemberBinding="{Binding Path=StartingMonth, StringFormat='MMMM yyyy', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                            Header="{x:Static r:Resources.MainView_CashFlowPeriods_Header_StartingMonth}"
                            Width="160"/>
                                <GridViewColumn
                            DisplayMemberBinding="{Binding Path=EndingMonth, StringFormat='MMMM yyyy', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                            Header="{x:Static r:Resources.MainView_CashFlowPeriods_Header_EndingMonth}"
                            Width="160"/>
                                <GridViewColumn
                            DisplayMemberBinding="{Binding Path=MonthlyAmount, StringFormat='#,0.00', ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"
                            Header="{x:Static r:Resources.MainView_CashFlowPeriods_Header_MonthlyAmount}"
                            Width="160"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel>
                        <Button Content="{x:Static r:Resources.MainView_Button_Content_RemoveCashFlowPeriod}" Command="{Binding RemoveSelectedCashFlowPeriodCommand}" VerticalContentAlignment="Center" Padding="5" Margin="5,0,0,5"/>
                        <Button Content="{x:Static r:Resources.MainView_Button_Content_AddCashFlowPeriod}" Command="{Binding AddNewCashFlowPeriodCommand}" VerticalContentAlignment="Center" Padding="5" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
        <oxy:PlotView Grid.Row="4" Model="{Binding PlotModelRemainingAmounts}" Margin="0,10,0,0"/>
    </Grid>
</Window>
